# true: MSW mocks + simulated run events. false: talk to the real playground-bff.
VITE_USE_MOCKS=false
# BFF origin. `pnpm --filter @playground/bff dev` listens on http://localhost:3001; the Docker Compose
# stack publishes it on http://localhost:8101. Empty = same origin (the Compose UI on :8100 proxies /api).
VITE_BFF_URL=http://localhost:3001
